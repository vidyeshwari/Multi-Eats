# Neon / Render cloud connection (if set, overrides DB_* below)
# DATABASE_URL=postgresql://username:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require

DB_USER=postgres
DB_PASSWORD=your_db_password_here
# Three-laptop demo: put the IP of the laptop that runs PostgreSQL here
DB_HOST=localhost
DB_PORT=5432
DB_NAME=food_delivery
PORT=5000
# Secret used to sign login tokens. Put any long random text here.
AUTH_SECRET=your_auth_secret_here
# Demo restaurant-panel login created by "npm run setup-db"
RESTAURANT_EMAIL=restaurant@multieats.test
RESTAURANT_PASSWORD=restaurant123
# ONE shared login for all restaurants (it selects the restaurant after login)
PORTAL_EMAIL=restaurants@multieats.test
PORTAL_PASSWORD=Rest@urant#Panel9
# NOTE: delivery fee and distance limits are no longer here. They are rows in the AppConfig table (database/schema.sql).
